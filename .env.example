# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard → Account & Settings → API Keys) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard → Webhooks. Point it at https://your-domain/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Shiprocket (optional; leave blank to skip automatic shipment creation) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must match a pickup location name in Shiprocket → Settings → Pickup addresses
SHIPROCKET_PICKUP_LOCATION=Primary

# --- Images (Cloudflare R2 public bucket hostname) ---
IMAGE_HOST=pub-xxxxxxxx.r2.dev

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for /admin. Leave blank locally and the page accepts loom-admin.
ADMIN_PASSWORD=
